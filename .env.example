# Optional conversational interpretation. Configure these as server-only Sites runtime values.
OPENAI_API_KEY=
OPENAI_HELP_MODEL=gpt-4.1-mini-2025-04-14
# Optional low-cost classifier used only when C.A. Atende rules cannot understand a message.
OPENAI_WHATSAPP_MODEL=gpt-4.1-mini-2025-04-14

# Server-only encryption key used to protect persisted provider credentials (Mercado Pago / WhatsApp).
# Use a random secret with at least 32 characters. Never commit the real value.
PLATFORM_SECRETS_ENCRYPTION_KEY=

# WhatsApp Business Platform (Meta Cloud API). Keep these server-only.
# The Graph version is explicit so the app never silently depends on an outdated hard-coded version.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_JOB_SECRET=
