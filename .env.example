# Optional conversational interpretation. Configure these as server-only Sites runtime values.
OPENAI_API_KEY=
OPENAI_HELP_MODEL=gpt-4.1-mini-2025-04-14
# Optional low-cost classifier used only when C.A. Atende rules cannot understand a message.
OPENAI_WHATSAPP_MODEL=gpt-4.1-mini-2025-04-14

# Server-only encryption key used to protect persisted provider credentials.
# Use a random secret with at least 32 characters. Never commit the real value.
PLATFORM_SECRETS_ENCRYPTION_KEY=

# Evolution API (preferred WhatsApp provider).
# EVOLUTION_API_URL is the public HTTPS address of the Evolution service, without a trailing slash.
# EVOLUTION_API_KEY is the server-only global API key of that service.
# EVOLUTION_WEBHOOK_SECRET must be a random secret with at least 24 characters and must match the header configured on Evolution webhooks.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=

# WhatsApp Business Platform (legacy/optional Meta Cloud provider).
# Kept for backward compatibility with organizations already connected through Meta.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Protects the internal queue-processing endpoint for both providers.
WHATSAPP_JOB_SECRET=
